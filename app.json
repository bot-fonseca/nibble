{
  "expo": {
    "name": "Nibble",
    "slug": "nibble",
    "scheme": "nibble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andre.nibble"
    },
    "android": {
      "package": "com.andre.nibble",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFF8EE"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1FA79A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nibble to use your camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "07ec6b20-e64c-47e4-a4d7-82a037f46be6"
      }
    },
    "owner": "fonsecs",
    "updates": {
      "url": "https://u.expo.dev/07ec6b20-e64c-47e4-a4d7-82a037f46be6"
    }
  }
}
